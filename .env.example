# Copy to .env (git-ignored). Values only, no secrets: auth is gcloud ADC.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-15e7fd834427
GOOGLE_CLOUD_LOCATION=europe-west1
# Gemini model served by Vertex AI in this project; check with the mentors if it 404s.
GEMINI_MODEL=gemini-2.5-flash
# Vertex AI Search (Discovery Engine) — set by scripts/ingest.py, or paste from the console.
GCS_BUCKET=qwiklabs-gcp-04-15e7fd834427-protocols
DATASTORE_ID=bspho-protocols
DATASTORE_LOCATION=global
