# Copy to .env (git-ignored). No secrets: auth is gcloud ADC.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-15e7fd834427
GOOGLE_CLOUD_LOCATION=global
# Gemini model on Vertex AI (verified in this project: gemini-3.8-flash, gemini-3.5-flash, gemini-3.1-pro-preview, gemini-2.5-flash; global endpoint).
GEMINI_MODEL=gemini-4-argon
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_THINKING=low
# Corpus folder (manifest.jsonl, pages/, protocols/, uploads/)
CORPUS_DIR=data/uc1
